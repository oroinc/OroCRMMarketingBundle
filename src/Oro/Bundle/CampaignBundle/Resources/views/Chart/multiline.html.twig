{# Chart variables format:

    "options":
        "name": "chart_name",
        "data_schema" => array(
            "label" => array("field_name" => "name", "label" => "First Name", "type" => "string"),
            "value" => array("field_name" => "salary", "label" => "Salary", "type" => "money"),
        ),
        "settings" => array(
            "foo" => "bar"
        ),
    "config": { /** Chart config from in format of oro/charts.yml */ }
    "data": [
        {"label": "In progress", "value": 1000},
        {"label": "Lost", "value": 500},
        {"label": "Won", "value": 10000},
    ]

#}
{% if data|length > 0 %}
    {% set containerId = "chart-container-" ~ random() %}
    <div class="chart-container">
        <div class="clearfix">
            <div id="{{ containerId }}-chart" class="multiline-chart chart pull-left"></div>
        </div>
    </div>
    <script type="text/javascript">
        loadModules(['jquery', 'flotr2', 'orochart/js/data_formatter', 'oroui/js/mediator'],
            function($, Flotr, dataFormatter, mediator) {
                $(function() {
                    const chartElement = document.querySelector('#{{ containerId }}-chart');
                    const widgetElement = chartElement.closest('.chart-container').parentElement;

                    const setChartSize = () => {
                        const chartWidth = Math.round(widgetElement.offsetWidth * 0.75);

                        if (chartWidth !== chartElement.offsetWidth) {
                            chartElement.style.width = `${chartWidth}px`;
                            chartElement.style.height = `${Math.min(Math.round(chartWidth * 0.4), 450)}px`;

                            return true;
                        }

                        return false;
                    };

                    const setChartContainerSize = () => {
                        chartElement.closest('.clearfix').style.width = `${chartElement.offsetWidth}px`;
                    };

                    const drawChart = () => {
                        const xFormat = {{ options.data_schema.label.type|json_encode|raw }};
                        const yFormat = {{ options.data_schema.value.type|json_encode|raw }};
                        const xTitle = {{ options.data_schema.label.label|trans|json_encode|raw }};
                        const yTitle = {{ options.data_schema.value.label|trans|json_encode|raw }};
                        const connectDots = {{ options.settings.connect_dots_with_line|json_encode|raw }};
                        const colors = {{ config.default_settings.chartColors|json_encode|raw }};
                        const rawData = {{ data|json_encode|raw }};
                        const length = Object.values(rawData)[0]?.length ?? 0;

                        if (!chartElement.clientWidth) {
                            return;
                        }

                        if (dataFormatter.isValueNumerical(xFormat)) {
                            Object.values(rawData).forEach(data => {
                                data.sort((first, second) => {
                                    if (first.label == null) return -1;
                                    if (second.label == null) return 1;

                                    const firstLabel = dataFormatter.parseValue(first.label, xFormat);
                                    const secondLabel = dataFormatter.parseValue(second.label, xFormat);

                                    return firstLabel - secondLabel;
                                });
                            });
                        }

                        const getXLabel = data => {
                            let label = dataFormatter.formatValue(data, xFormat);

                            if (label === null) {
                                const number = parseInt(data);

                                if (rawData.length > number) {
                                    label = rawData[number]['label'] === null ? '{{ 'N/A'|trans }}' : rawData[number]['label'];
                                } else {
                                    label = '';
                                }
                            }

                            return label;
                        };

                        const getYLabel = data => {
                            let label = dataFormatter.formatValue(data, yFormat);

                            if (label === null) {
                                const number = parseInt(data);

                                if (rawData.length > number) {
                                    label = rawData[data]['value'] === null ? '{{ 'N/A'|trans }}' : rawData[data]['value'];
                                } else {
                                    label = '';
                                }
                            }

                            return label;
                        };

                        const makeChart = (data, count, key) => {
                            let prevYValue = 0;

                            const chartData = data.map(({ value, label }, index) => {
                                const parsedY = dataFormatter.parseValue(value, yFormat);
                                const yValue = (parsedY ?? index) + prevYValue;

                                const parsedX = dataFormatter.parseValue(label, xFormat);
                                const xValue = parsedX ?? index;

                                prevYValue = yValue;

                                return [xValue, yValue];
                            });

                            return {
                                label: key,
                                data: chartData,
                                color: colors[count % colors.length],
                                markers: { show: false },
                                points: { show: true },
                            };
                        };

                        const entries = Array.isArray(rawData)
                            ? rawData.map((data, index) => [index, data])
                            : Object.entries(rawData);

                        const charts = entries.map(([key, data], index) => makeChart(data, index, key));

                        Flotr.draw(
                            chartElement,
                            charts,
                            {
                                colors: colors,
                                fontColor: {{ options.settings.chartFontColor|json_encode|raw }},
                                fontSize: {{ options.settings.chartFontSize|json_encode|raw }},
                                lines: {
                                    show: connectDots
                                },
                                mouse: {
                                    track: true,
                                    relative: true,
                                    trackFormatter: pointData => {
                                        return `
                                            ${xTitle}: ${getXLabel(pointData.x)};
                                            </br> ${yTitle}: ${getYLabel(pointData.y)}
                                        `;
                                    }
                                },
                                yaxis: {
                                    autoscale: true,
                                    autoscaleMargin: 1,
                                    tickFormatter: y => getYLabel(y),
                                    title: yTitle
                                },
                                xaxis: {
                                    autoscale: true,
                                    autoscaleMargin: 0,
                                    labelsAngle: 45,
                                    mode: 'time',
                                    noTicks: length * 2,
                                    tickFormatter: x => getXLabel(x),
                                    title: xTitle
                                },
                                HtmlText: false,
                                grid: {
                                    verticalLines: false,
                                    labelMargin: 10
                                },
                                legend: {
                                    show: true,
                                    noColumns: 1,
                                    position: 'nw'
                                }
                            }
                        );
                    };

                    mediator.on('page:afterChange', function() {
                        setChartSize();
                        drawChart();
                        setChartContainerSize();
                    });

                    $(window).on('resize', function() {
                        if (setChartSize()) {
                            drawChart();
                            setChartContainerSize();
                        }
                    });
                });
            });
    </script>
{% endif %}
